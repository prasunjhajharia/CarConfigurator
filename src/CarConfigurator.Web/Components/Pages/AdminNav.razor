<div style="display: flex; gap: 8px; align-items: center; margin-bottom: 1.5rem;">
    <MudButton Href="/admin/options"
               Variant="@(Active == "options" ? Variant.Filled : Variant.Outlined)"
               Color="Color.Primary">Options</MudButton>
    <MudButton Href="/admin/trims"
               Variant="@(Active == "trims" ? Variant.Filled : Variant.Outlined)"
               Color="Color.Primary">Trims</MudButton>

    <span style="flex: 1;"></span>

    <form method="post" action="/auth/logout" style="margin: 0;">
        <button type="submit"
                style="padding: 6px 16px; border-radius: 12px; border: 1px solid #3a3f49; background: transparent; color: #f2f2f2; cursor: pointer; font-size: 0.9rem;">
            Log out
        </button>
    </form>
</div>

@code {
    [Parameter]
    public string Active { get; set; } = string.Empty;
}