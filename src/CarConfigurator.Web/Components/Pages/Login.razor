@page "/login"

<PageTitle>Admin login</PageTitle>

<div style="max-width: 420px; margin: 3rem auto;">
    <MudText Typo="Typo.overline" Color="Color.Primary">Admin</MudText>
    <MudText Typo="Typo.h4" Class="mb-4" Style="font-weight: 600;">Sign in</MudText>

    @if (Error == "1")
    {
        <MudAlert Severity="Severity.Error" Class="mb-3">Wrong password.</MudAlert>
    }

    <MudPaper Class="price-panel pa-5" Elevation="0">
        <form method="post" action="/auth/login">
            <label for="password" style="display: block; font-size: 0.9rem; color: #a3a8b3;">Password</label>
            <input id="password" name="password" type="password" autofocus
                   style="width: 100%; padding: 10px 12px; margin: 6px 0 16px; border-radius: 8px; border: 1px solid #3a3f49; background: #0e1014; color: #f2f2f2; font-size: 1rem;" />
            <button type="submit"
                    style="width: 100%; padding: 10px; border: none; border-radius: 12px; background: #d4a24c; color: #111111; font-weight: 600; font-size: 1rem; cursor: pointer;">
                Sign in
            </button>
        </form>
    </MudPaper>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? Error { get; set; }
}